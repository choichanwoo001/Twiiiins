# 데이터베이스 설정
DB_URL=jdbc:mysql://localhost:3306/twiiiins?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=twiiiins_user
DB_PASSWORD=your_secure_password_here

# JWT 설정
JWT_SECRET=your_jwt_secret_key_here_32_chars_minimum

# Stripe 설정 (선택사항)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# CORS 설정
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com

# 서버 설정
PORT=8080
SERVER_CONTEXT_PATH=

# 파일 업로드 설정
FILE_UPLOAD_DIR=uploads
FILE_MAX_SIZE=15728640

# 로깅 설정
LOG_LEVEL=INFO
SERVICE_LOG_LEVEL=DEBUG
CONTROLLER_LOG_LEVEL=INFO
EXCEPTION_LOG_LEVEL=WARN

# AWS S3 설정 (선택사항)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=twiiiins-uploads
