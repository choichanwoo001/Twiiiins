{
  "name": "twiiiins-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dummy": "vite --mode dummy",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
