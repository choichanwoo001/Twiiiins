{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.js" },
  "mutate": ["src/utils/apiCache.js", "src/utils/downloadLinks.js", "src/utils/newsLanguage.js", "src/services/apiResponse.js"],
  "reporters": ["clear-text", "html", "json"],
  "coverageAnalysis": "perTest",
  "ignorePatterns": [".env*", "**/*.timestamp-*.mjs", ".cache/**", "test-results/**", "coverage/**", "reports/**", "dist/**"],
  "concurrency": 2,
  "thresholds": { "high": 80, "low": 60, "break": 60 }
}
