# Copy values into your backend environment, or GitHub Actions secrets for deployment.
# Keep disabled until SMTP, domain authentication, privacy notice and real inbox tests are complete.
NEWSLETTER_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=news@example.com
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
NEWSLETTER_TOKEN_KEY=
NEWSLETTER_PUBLIC_URL=https://twiiiins.com
NEWSLETTER_FROM=news@example.com
NEWSLETTER_REPLY_TO=contact@example.com
NEWSLETTER_OPERATOR=
NEWSLETTER_TEST_RECIPIENTS=admin@example.com
# Optional local Mailpit UI hint; leave blank for deployment.
NEWSLETTER_LOCAL_MAILBOX_URL=
NEWSLETTER_PER_MINUTE=10
NEWSLETTER_DAILY_LIMIT=300
# Only needed when explicitly bootstrapping a NEW administrator account.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
